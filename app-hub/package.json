{
  "name": "app-hub",
  "productName": "App Hub",
  "version": "1.7.0",
  "description": "Your apps in one window, with AI models picked for your PC.",
  "author": "Bryce",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis portable --publish never",
    "build:apps": "cd ../app-hub-dashboard && npm ci --no-audit --no-fund && npm run build && npm prune --omit=dev && cd ../app-hub-grammar/frontend && npm ci --no-audit --no-fund && npm run build && cd ../backend && npm ci --omit=dev --no-audit --no-fund"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bryce.apphub",
    "productName": "App Hub",
    "files": [
      "main.js",
      "mcp.js",
      "mcp-tools.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "hub.css",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../ClipForge",
        "to": "ClipForge",
        "filter": [
          "**/*",
          "!.venv",
          "!.venv/**",
          "!node_modules",
          "!node_modules/**",
          "!bin",
          "!bin/**",
          "!data/projects/**",
          "!data/models/**",
          "!data/music/**",
          "!data/settings.json",
          "!tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../app-hub-grammar",
        "to": "app-hub-grammar",
        "filter": [
          "backend/package.json",
          "backend/src/**",
          "!backend/src/**/*.test.js",
          "backend/node_modules/**",
          "frontend/build/**"
        ]
      },
      {
        "from": "../app-hub-dashboard",
        "to": "app-hub-dashboard",
        "filter": [
          "package.json",
          "server.js",
          "dist/**",
          "node_modules/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "App-Hub-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "App-Hub-Portable-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "publish": null
  }
}
